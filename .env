BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

BINANCE_TESTNET_URL=https://testnet.binance.vision/api
BINANCE_LIVE_URL=https://api.binance.com/api

USE_TESTNET=true
AUTO_TRADE_ENABLED=false
DASHBOARD_PASSWORD=bottie
SCAN_MODE=SELECTED
MIN_CONFIDENCE=0.65
MAX_POSITIONS=3
SCAN_INTERVAL=300
MIN_QUANTUM_CONFIDENCE=0.7
SCAN_INTERVAL_MINUTES=30

RISK_PERCENTAGE=0.015
MAX_RISK_PER_TRADE=0.015
RISK_LEVEL=Balanced
MAX_TOTAL_LOSS_PERCENT=10.0
MAX_TRADING_HOURS_PER_DAY=24

STRATEGY=Breakout
TRADING_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT
PORTFOLIO_VALUE=10000
MAX_CONCURRENT_POSITIONS=3

CUSTOM_SYMBOLS=BTCUSDT,ETHUSDT,ADAUSDT,SOLUSDT,BNBUSDT

FORCE_LIVE_MODE=false
PORT=8501
DEBUG_MODE=false
LOG_LEVEL=INFO
MAX_LOG_SIZE_MB=100
LOG_FILE_COUNT=10

TELEGRAM_BOT_TOKEN=your_telegram_token
TELEGRAM_CHAT_ID=your_chat_id
EMAIL_ENABLED=false
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
