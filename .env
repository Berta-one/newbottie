
# Trading Configuration
USE_TESTNET=False
MIN_BALANCE_USD=10.0

# Risk Management Settings
DEFAULT_RISK_PROFILE=BALANCED
MAX_POSITIONS=3
RISK_PERCENTAGE=0.015

# Dashboard Settings
DASHBOARD_PASSWORD=bottie
AUTO_START_BOT=True

# Notification Settings (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_NOTIFICATIONS=False

# IMMEDIATE .env CONFIGURATION FIXES
# Apply these changes to your .env file NOW

# ================================
# FIX 1: INVALID SYMBOL FILTERING
# ================================
INVALID_SYMBOLS=NFT,ETHW,LUNA,UST,FTT
SKIP_INVALID_SYMBOLS=True

# ================================  
# FIX 2: STRATEGY THRESHOLDS
# ================================
# Current: 0.39% threshold (too low)
# Fixed: Proper thresholds for scalping vs breakout

# For SCALPING strategy:
SCALPING_MIN_CHANGE=2.0              # 2% minimum price change
SCALPING_MIN_VOLUME=1.5              # 1.5x volume ratio  
SCALPING_MIN_CONFIDENCE=0.65         # 65% confidence minimum
SCALPING_SCAN_INTERVAL=60            # 60 seconds (not 4 seconds!)

# For BREAKOUT strategy:
BREAKOUT_MIN_CHANGE=5.0              # 5% minimum price change
BREAKOUT_MIN_VOLUME=2.0              # 2x volume ratio
BREAKOUT_MIN_CONFIDENCE=0.70         # 70% confidence minimum  
BREAKOUT_SCAN_INTERVAL=300           # 5 minutes

# ================================
# FIX 3: ENABLE ACTUAL TRADING
# ================================
# Current: Creating test opportunities only
# Fixed: Enable real trading

PAPER_TRADING=False                  # SET TO FALSE FOR REAL TRADING
DRY_RUN=False                       # SET TO FALSE FOR EXECUTION
TEST_MODE=False                     # SET TO FALSE FOR LIVE ORDERS

# Safety settings
MIN_TRADE_AMOUNT=10                 # Minimum $10 trades
MAX_TRADE_AMOUNT=100                # Maximum $100 trades for safety

# ================================
# FIX 4: RATE LIMITING PROTECTION  
# ================================
# Current: Scanning every 4 seconds (dangerous)
# Fixed: Proper rate limiting

SCAN_INTERVAL=60                    # 60 seconds minimum
MAX_API_CALLS_PER_MINUTE=50         # Conservative API usage
ENABLE_RATE_LIMITING=True           # Enable protection
API_COOLDOWN_SECONDS=2              # 2 second delay between calls

# ================================
# FIX 5: XRP OPPORTUNITY SETTINGS
# ================================
# Your bot keeps finding XRP but not trading
# Current XRP stats: 0.341% change, 1.08x volume, 0.468 confidence

# Why XRP isn't trading:
# - Change too small: 0.341% < 2.0% required
# - Volume borderline: 1.08x < 1.5x required  
# - Confidence too low: 0.468 < 0.65 required

# Updated thresholds to catch better opportunities:
MIN_CONFIDENCE=0.65
MIN_VOLUME_RATIO=1.5
MIN_PRICE_CHANGE=2.0

# ================================
# FIX 6: PORTFOLIO SETTINGS
# ================================
# Your portfolio: $2,700 across 4 assets (BNB, XRP, ADA, SOL)

MAX_POSITION_SIZE=400               # Max $400 per position
MAX_PORTFOLIO_RISK=0.15             # 15% of portfolio at risk
DIVERSIFICATION_TARGET=8            # Target 8+ different assets

# Asset allocation targets:
TARGET_BTC_ALLOCATION=0.30          # 30% in BTC
TARGET_ETH_ALLOCATION=0.25          # 25% in ETH  
TARGET_MAJOR_ALLOCATION=0.55        # 55% in major cryptos
TARGET_ALT_ALLOCATION=0.45          # 45% in altcoins

# ================================
# FIX 7: STRATEGY OVERRIDE SETTINGS
# ================================
# Current: Strategy override active (Scalping/Aggressive)

STRATEGY_OVERRIDE=False             # Disable override to use dynamic strategy
FORCE_STRATEGY=None                 # Don't force specific strategy
ADAPTIVE_STRATEGY=True              # Enable adaptive strategy selection

# If keeping scalping:
SCALPING_TAKE_PROFIT=3.0            # 3% take profit for scalping
SCALPING_STOP_LOSS=2.0              # 2% stop loss for scalping  
SCALPING_MAX_HOLD_TIME=1800         # 30 minutes max hold

# ================================
# CRITICAL ACTIONS REQUIRED
# ================================

# 1. UPDATE YOUR .env FILE WITH ABOVE SETTINGS
# 2. RESTART YOUR BOT
# 3. MONITOR FOR 30 MINUTES  
# 4. VERIFY NO MORE "Invalid symbol" ERRORS
# 5. CONFIRM SCAN INTERVAL IS 60+ SECONDS
# 6. CHECK IF ACTUAL TRADES EXECUTE (NOT JUST TEST)

# ================================
# VERIFICATION COMMANDS
# ================================

# Check if fixes worked:
# - Look for "Invalid symbol" errors (should be gone)
# - Scan interval should be 60+ seconds  
# - Confidence should be 0.65+ for opportunities
# - Volume ratio should be 1.5x+ for opportunities
# - Should see "REAL TRADE EXECUTED" not "test opportunity"