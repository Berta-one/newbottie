# .env - Crypto Trading Bot Configuration
# ⚠️  IMPORTANT: Never commit this file to Git! Keep your API keys secret.

# ═══════════════════════════════════════════════════════════════════
# 🔐 BINANCE API CREDENTIALS
# ═══════════════════════════════════════════════════════════════════
# Get these from: https://www.binance.com/en/my/settings/api-management
# For testnet: https://testnet.binance.vision/

BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ═══════════════════════════════════════════════════════════════════
# 🌐 API ENDPOINTS
# ═══════════════════════════════════════════════════════════════════

BINANCE_TESTNET_URL=https://testnet.binance.vision/api
BINANCE_LIVE_URL=https://api.binance.com/api

# ═══════════════════════════════════════════════════════════════════
# 🤖 BOT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# Trading Mode (CRITICAL SETTING!)
USE_TESTNET=True                    # True=Safe testing, False=Real money
ENABLE_PAPER_TRADING=True           # True=Simulate trades, False=Real trades

# Strategy Configuration
USE_ML_ENHANCEMENT=True             # Enable ML-enhanced signals
STRATEGY_COMPARISON_MODE=True       # A/B test Traditional vs ML strategies

# ═══════════════════════════════════════════════════════════════════
# 💰 TRADING PARAMETERS
# ═══════════════════════════════════════════════════════════════════

# Single-Pair Bot Settings
TRADE_SYMBOL=BTCUSDT               # Which crypto pair to trade
BASE_TRADE_QTY=0.001               # Base position size
RISK_PERCENTAGE=0.015              # Risk 1.5% of account per trade
MAX_HOLD_TIME_MINUTES=240          # Maximum 4 hours per position

# Multi-Pair Scanner Settings
SCAN_MODE=SELECTED                 # Options: ALL, SELECTED, CUSTOM
MIN_CONFIDENCE=0.65                # Minimum confidence for trades
MAX_POSITIONS=3                    # Maximum simultaneous positions
SCAN_INTERVAL=300                  # Scan every 5 minutes (seconds)

# Custom Symbols (used when SCAN_MODE=CUSTOM)
CUSTOM_SYMBOLS=BTCUSDT,ETHUSDT,ADAUSDT,SOLUSDT,BNBUSDT

# ═══════════════════════════════════════════════════════════════════
# 🔔 DASHBOARD & ALERTS
# ═══════════════════════════════════════════════════════════════════

# Dashboard Security
DASHBOARD_PIN=1234                 # PIN to access dashboard

# Telegram Bot (Optional - for trade alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ═══════════════════════════════════════════════════════════════════
# ⚙️ ADVANCED SETTINGS
# ═══════════════════════════════════════════════════════════════════

# Performance Settings
ENABLE_ADVANCED_LOGGING=True       # Detailed performance tracking
AUTO_SAVE_REPORTS=True             # Automatically save session reports

# Risk Management
EMERGENCY_STOP_LOSS=0.20           # Emergency stop at 20% loss
MAX_DAILY_TRADES=10                # Limit trades per day
COOLDOWN_AFTER_LOSS_MINUTES=60     # Wait 1 hour after stop loss

# Technical Analysis
ENABLE_VOLUME_FILTER=True          # Require volume confirmation
ENABLE_TIME_FILTER=True            # Avoid low-volume trading hours
VOLATILITY_THRESHOLD=0.05          # Maximum volatility threshold

# ═══════════════════════════════════════════════════════════════════
# 🧠 MACHINE LEARNING SETTINGS
# ═══════════════════════════════════════════════════════════════════

ML_MODEL_PATH=models/trading_model.pkl
ML_RETRAIN_INTERVAL_HOURS=24       # Retrain model every 24 hours
ML_MIN_TRAINING_SAMPLES=100        # Minimum data for training
ML_CONFIDENCE_WEIGHT=0.4           # ML weight in combined decision (0.0-1.0)

# ═══════════════════════════════════════════════════════════════════
# 🎯 QUICK CONFIGURATION PRESETS
# ═══════════════════════════════════════════════════════════════════

# Uncomment one of these preset configurations:

# 🛡️  CONSERVATIVE PRESET (Recommended for beginners)
# RISK_PERCENTAGE=0.01
# MIN_CONFIDENCE=0.75
# MAX_POSITIONS=2
# SCAN_INTERVAL=600

# ⚡ AGGRESSIVE PRESET (Higher risk/reward)
# RISK_PERCENTAGE=0.025
# MIN_CONFIDENCE=0.60
# MAX_POSITIONS=5
# SCAN_INTERVAL=180

# 🧪 TESTING PRESET (Safe experimentation)
# USE_TESTNET=True
# ENABLE_PAPER_TRADING=True
# STRATEGY_COMPARISON_MODE=True
# ENABLE_ADVANCED_LOGGING=True

# ═══════════════════════════════════════════════════════════════════
# 📋 SETUP CHECKLIST
# ═══════════════════════════════════════════════════════════════════
#
# ✅ 1. Replace 'your_binance_api_key_here' with your actual API key
# ✅ 2. Replace 'your_binance_api_secret_here' with your actual secret
# ✅ 3. Start with USE_TESTNET=True for safe testing
# ✅ 4. Use ENABLE_PAPER_TRADING=True initially
# ✅ 5. Set DASHBOARD_PIN to your preferred 4-digit code
# ✅ 6. Choose your TRADE_SYMBOL (BTCUSDT, ETHUSDT, etc.)
# ✅ 7. Adjust RISK_PERCENTAGE to your comfort level
# ✅ 8. Test with small BASE_TRADE_QTY first
#
# ⚠️  IMPORTANT REMINDERS:
# - Never share this file or commit it to Git
# - Start with testnet and paper trading
# - Monitor your bot closely when first running
# - Only risk money you can afford to lose
# - Cryptocurrency trading involves substantial risk
#
# ═══════════════════════════════════════════════════════════════════
