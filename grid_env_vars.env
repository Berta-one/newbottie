# Enhanced Grid System Environment Variables
# Add these to your existing .env file or Render environment variables

# Grid WebSocket Configuration (with rollback switch)
ENABLE_GRID_WS=1                  # Set to 0 to disable WebSocket engine (rollback/safe mode)
API_ENABLE_GRID_WS=1              # Render-specific: for API service
BOTTIE_ENABLE_GRID_WS=1           # Render-specific: for bot service

# Grid Matrix Configuration
GRID_MAX_COLS=80                  # Increased from 60 for maxi-grid
GRID_STABLES=USDT,USDC,BUSD,DAI
PRIMARY_QUOTE=USDT
EXCHANGE_ID=binance

# Dynamic Trading Thresholds (NEW - replaces single TRADE_MIN_CONF)
TRADE_CONF_FLOOR=0.50             # Lower bound: ≤ SELL signal
TRADE_CONF_CEIL=0.80              # Upper bound: ≥ BUY signal
# Note: Between floor and ceil = HOLD signal

# Signal Blending Weights for Grid
EMA_WEIGHT=0.40
ML_WEIGHT=0.30
QUANTUM_WEIGHT=0.20
SENTIMENT_WEIGHT=0.10

# Optional: Limit grid to specific symbols (CSV format)
# TRADE_SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,ADA/USDT,DOT/USDT

# Grid System Features
ML_ENABLED=1
QUANTUM_ENABLED=0
SENTIMENT_ENABLED=1

# WebSocket Performance & Resilience
WS_RECONNECT_BACKOFF_MAX=20.0     # Max backoff seconds for reconnection
WS_BATCH_SIZE=50                  # Symbols per WebSocket batch
WS_RESCAN_INTERVAL=60             # Seconds between balance/symbol rescans
