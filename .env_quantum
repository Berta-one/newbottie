# Autonomous Quantum Trading Bot Configuration
# Copy this to your .env file or set as Railway environment variables

# =============================================================================
# AUTONOMOUS TRADING CONTROL
# =============================================================================

# Enable/disable autonomous trading (IMPORTANT: Start with false!)
AUTO_TRADE_ENABLED=false

# Quantum signal requirements
MIN_QUANTUM_CONFIDENCE=0.7
MAX_CONCURRENT_POSITIONS=3
SCAN_INTERVAL_MINUTES=30

# Trading strategy
RISK_LEVEL=Balanced
STRATEGY=Breakout
TRADING_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT
PORTFOLIO_VALUE=10000

# =============================================================================
# EXISTING BINANCE CONFIGURATION (Keep your existing values)
# =============================================================================

# Your Binance API credentials
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Trading mode
USE_TESTNET=true

# Dashboard password
DASHBOARD_PASSWORD=bottie

# =============================================================================
# SAFETY SETTINGS
# =============================================================================

# Maximum risk per trade (1.5% of portfolio)
MAX_RISK_PER_TRADE=0.015

# Emergency stop if total loss exceeds this percentage
MAX_TOTAL_LOSS_PERCENT=10.0

# Maximum trading hours per day (24 = always on)
MAX_TRADING_HOURS_PER_DAY=24

# =============================================================================
# NOTIFICATION SETTINGS (Optional)
# =============================================================================

# Telegram bot token (optional)
TELEGRAM_BOT_TOKEN=your_telegram_token

# Telegram chat ID (optional)
TELEGRAM_CHAT_ID=your_chat_id

# Email notifications (optional)
EMAIL_ENABLED=false
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# =============================================================================
# LOGGING SETTINGS
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Maximum log file size (MB)
MAX_LOG_SIZE_MB=100

# Number of log files to keep
LOG_FILE_COUNT=10
