# Configuration and code provided inside ZIP
# .env.example

# Binance API Keys
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_here

# Model paths (assumed to be under ./models)
LSTM_MODEL_PATH=models/lstm_model.h5
XGB_MODEL_PATH=models/xgb_model.json

# Dashboard
DASHBOARD_PORT=8501

# News API for sentiment
NEWS_API_KEY=your_news_api_key

# Email Alerts
EMAIL_SENDER=bottie@yourdomain.com
EMAIL_PASSWORD=app_specific_password
EMAIL_RECEIVER=alerts@yourdomain.com