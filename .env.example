# Configuration and code provided inside ZIP
# .env.example

# Binance API Keys
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_secret_here

# Trading Mode
DEMO_MODE=0

# Model paths (assumed to be under ./models)
LSTM_MODEL_PATH=models/lstm_model.h5
XGB_MODEL_PATH=models/xgb_model.json

# Dashboard
DASHBOARD_PORT=8501

# News / sentiment (Finnhub is used by much of the sentiment stack)
FINNHUB_API_KEY=your_finnhub_key
# News API for sentiment (alternate path in some modules)
NEWS_API_KEY=your_news_api_key

# Email Alerts
EMAIL_SENDER=bottie@yourdomain.com
EMAIL_PASSWORD=app_specific_password
EMAIL_RECEIVER=alerts@yourdomain.com

# Admin credentials for API authentication
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password
