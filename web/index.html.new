<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Bottie Dashboard</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<!-- Add Chart.js BEFORE your app.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
<style>
  * { box-sizing: border-box; }
  body { 
    font-family: Arial, sans-serif; 
    background: #0c1426; 
    color: #ffffff;
    margin: 0; 
    padding: 0; 
    font-size: 14px;
  }
  
  header { 
    background: #1a2332; 
    color: #fff; 
    padding: 12px 20px; 
    font-size: 18px; 
    border-bottom: 1px solid #2a3441;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .user-info {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
  }
  
  .user-badge {
    background: #64ffda;
    color: #0c1426;
    padding: 4px 8px;
    border-radius: 4px;
    font-weight: 600;
    text-transform: uppercase;
  }
  
  .logout-btn {
    background: #f44336;
    color: #ffffff;
    border: none;
    padding: 6px 12px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 11px;
  }

  /* Tab Navigation */
  .dashboard-tabs {
    background: #1a2332;
    border-bottom: 1px solid #2a3441;
    padding: 0 20px;
    display: flex;
    gap: 0;
  }
  
  .tab-btn {
    background: none;
    border: none;
    color: #8892b0;
    padding: 12px 20px;
    cursor: pointer;
    border-bottom: 3px solid transparent;
    transition: all 0.2s ease;
    font-size: 14px;
    font-weight: 500;
  }
  
  .tab-btn:hover {
    color: #64ffda;
    background: rgba(100, 255, 218, 0.05);
  }
  
  .tab-btn.active {
    color: #64ffda;
    border-bottom-color: #64ffda;
    background: rgba(100, 255, 218, 0.1);
  }
  
  .tab-content {
    display: none;
  }
  
  .tab-content.active {
    display: block;
  }
  
  main { 
    max-width: 1600px; 
    margin: auto; 
    padding: 20px; 
  }
  
  /* Login Modal Styles */
  .login-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(12, 20, 38, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3000;
  }
  
  .login-form {
    background: #1a2332;
    border: 1px solid #2a3441;
    border-radius: 8px;
    padding: 30px;
    min-width: 400px;
    text-align: center;
  }
  
  .login-form h2 {
    color: #64ffda;
    margin-bottom: 20px;
  }
  
  .form-group {
    margin-bottom: 15px;
    text-align: left;
  }
  
  .form-label {
    display: block;
    color: #ffffff;
    margin-bottom: 5px;
    font-size: 12px;
  }
  
  .form-input {
    width: 100%;
    background: #0f1419;
    border: 1px solid #2a3441;
    border-radius: 4px;
    padding: 10px;
    color: #ffffff;
    font-size: 14px;
  }
  
  .form-input:focus {
    outline: none;
    border-color: #64ffda;
  }
  
  .login-btn {
    width: 100%;
    background: #64ffda;
    color: #0c1426;
    border: none;
    padding: 12px;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    margin-top: 10px;
  }
  
  .login-btn:hover {
    opacity: 0.8;
  }
  
  .login-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  
  .login-error {
    color: #f44336;
    font-size: 12px;
    margin-top: 10px;
  }
  
  /* Debug Panel */
  .debug-panel {
    position: fixed;
    top: 10px;
    right: 10px;
    background: #1a2332;
    border: 1px solid #2a3441;
    border-radius: 8px;
    padding: 16px;
    min-width: 280px;
    max-height: 80vh;
    overflow-y: auto;
    z-index: 1000;
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }
  
  .debug-panel.open {
    transform: translateX(0);
  }
  
  .debug-toggle {
    position: fixed;
    top: 10px;
    right: 10px;
    background: #64ffda;
    color: #0c1426;
    border: none;
    border-radius: 6px;
    padding: 8px 12px;
    cursor: pointer;
    font-weight: 600;
    font-size: 12px;
    z-index: 1001;
  }
  
  .debug-header {
    color: #64ffda;
    font-weight: 600;
    margin-bottom: 12px;
    font-size: 14px;
  }
  
  .card {
    background: #0f1419;
    border: 1px solid #2a3441;
    border-radius: 6px;
    padding: 15px;
    margin-bottom: 15px;
  }
  
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }
  
  .chip {
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
  }
  
  .chip--ok { background: rgba(76, 175, 80, 0.2); color: #4caf50; border: 1px solid #4caf50; }
  .chip--warn { background: rgba(255, 152, 0, 0.2); color: #ff9800; border: 1px solid #ff9800; }
  .chip--err { background: rgba(244, 67, 54, 0.2); color: #f44336; border: 1px solid #f44336; }
  
  .kv {
    display: flex;
    justify-content: space-between;
    margin: 8px 0;
    font-size: 13px;
  }
  
  .k { color: #8892b0; }
  .v { font-weight: 600; color: #ffffff; }
  
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
  }
  
  .data-table th {
    background: #0f1419;
    padding: 8px 6px;
    text-align: left;
    font-weight: 600;
    color: #64ffda;
    border-bottom: 1px solid #2a3441;
    position: sticky;
    top: 0;
    z-index: 10;
  }
  
  .data-table td {
    padding: 6px;
    border-bottom: 1px solid #2a3441;
  }
  
  .data-table tr:hover {
    background: rgba(100, 255, 218, 0.05);
  }
  
  .symbol {
    font-family: monospace;
    font-weight: 600;
  }
  
  .hold-badge { background: #ff9800; color: #ffffff; padding: 2px 6px; border-radius: 3px; font-size: 10px; }
  .buy-badge { background: #4caf50; color: #ffffff; padding: 2px 6px; border-radius: 3px; font-size: 10px; }
  .sell-badge { background: #f44336; color: #ffffff; padding: 2px 6px; border-radius: 3px; font-size: 10px; }
  
  .positive { color: #4caf50; }
  .negative { color: #f44336; }
  
  /* Rest of your existing styles... */
  .main-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 15px;
  }

  h3 {
    color: #64ffda;
    margin: 0 0 10px 0;
    font-size: 14px;
  }

  /* Auto-login bypass notice */
  .auto-login-notice {
    position: fixed;
    top: 50px;
    right: 10px;
    background: #4caf50;
    color: white;
    padding: 10px;
    border-radius: 4px;
    font-size: 12px;
    z-index: 2000;
    animation: fadeInOut 3s ease-in-out;
  }

  @keyframes fadeInOut {
    0%, 100% { opacity: 0; }
    20%, 80% { opacity: 1; }
  }
</style>
</head>
<body>

<!-- Auto-login notice -->
<div class="auto-login-notice">
  ✅ Auto-logged in as admin
</div>

<!-- Login Modal (will be hidden by auto-login) -->
<div id="login-modal" class="login-modal" style="display: none;">
  <div class="login-form">
    <h2>🔒 Bottie Access</h2>
    <form id="login-form">
      <div class="form-group">
        <label class="form-label">Username</label>
        <input type="text" id="username" class="form-input" value="admin" required>
      </div>
      <div class="form-group">
        <label class="form-label">Password</label>
        <input type="password" id="password" class="form-input" value="Diego1234!" required>
      </div>
      <button type="submit" id="login-btn" class="login-btn">Login</button>
      <div id="login-error" class="login-error"></div>
    </form>
  </div>
</div>

<header>
  <div>Bottie Live Dashboard</div>
  <div class="user-info" id="user-info">
    <span id="user-name" class="user-badge">admin</span>
    <button id="logout-btn" class="logout-btn">Logout</button>
  </div>
</header>

<!-- Tab Navigation -->
<div class="dashboard-tabs" id="dashboard-tabs">
  <button class="tab-btn active" data-tab="trading">📊 Trading</button>
  <button class="tab-btn" data-tab="ml-monitor">🧠 ML Learning</button>
  <button class="tab-btn" data-tab="quantum">⚡ Quantum Analysis</button>
</div>

<main id="main-content">
  
  <!-- Trading Tab -->
  <div id="trading-tab" class="tab-content active">
    <div class="main-grid">
      <!-- System Health Status -->
      <div class="card">
        <div class="card-header">
          <h3>📋 System Health</h3>
          <span id="quantum-chip" class="chip chip--ok">Online</span>
        </div>
        <div class="kv">
          <span class="k">Quantum Backend:</span>
          <span class="v" id="quantum-backend">—</span>
        </div>
        <div class="kv">
          <span class="k">ML Status:</span>
          <span class="v" id="ml-chip" class="chip">—</span>
        </div>
        <div class="kv">
          <span class="k">Sentiment:</span>
          <span class="v" id="sent-chip" class="chip">—</span>
        </div>
      </div>

      <!-- Current Signals -->
      <div class="card">
        <div class="card-header">
          <h3>📡 Current Signals</h3>
        </div>
        <div style="overflow-x: auto;">
          <table id="signals-table" class="data-table">
            <thead>
              <tr>
                <th>Symbol</th>
                <th>Signal</th>
                <th>Confidence</th>
                <th>EMA</th>
                <th>ML</th>
                <th>Quantum</th>
                <th>Sentiment</th>
              </tr>
            </thead>
            <tbody>
              <tr><td colspan="7" style="text-align: center; color: #8892b0;">Loading signals...</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Positions -->
      <div class="card">
        <div class="card-header">
          <h3>💼 Current Positions</h3>
        </div>
        <div id="positions-container">
          <p style="color: #8892b0;">Loading positions...</p>
        </div>
      </div>

      <!-- Equity Chart -->
      <div class="card">
        <div class="card-header">
          <h3>📈 Equity Performance</h3>
        </div>
        <canvas id="equity-canvas" width="400" height="200"></canvas>
        <div id="chart-stats" style="margin-top: 10px; font-size: 12px; color: #8892b0;">
          Loading chart...
        </div>
      </div>

      <!-- System Logs -->
      <div class="card">
        <div class="card-header">
          <h3>📋 System Logs</h3>
        </div>
        <div id="logs" style="background: #0f1419; color: #ffffff; padding: 10px; border-radius: 4px; font-family: monospace; font-size: 11px; max-height: 200px; overflow-y: auto;">
          Loading logs...
        </div>
      </div>
    </div>
  </div>

  <!-- ML Monitor Tab -->
  <div id="ml-monitor-tab" class="tab-content">
    <div class="main-grid">
      <div class="card">
        <h3>🧠 ML Performance Chart</h3>
        <canvas id="performance-chart" width="400" height="300"></canvas>
      </div>
    </div>
  </div>

  <!-- Quantum Analysis Tab -->
  <div id="quantum-tab" class="tab-content">
    <div class="main-grid">
      <div class="card">
        <h3>⚡ Quantum System Status</h3>
        <div class="kv">
          <span class="k">Backend:</span>
          <span class="v" id="quantum-backend-detail">—</span>
        </div>
      </div>
    </div>
  </div>
</main>

<!-- Debug Panel -->
<button class="debug-toggle" id="debug-toggle">🔧 Debug</button>

<div class="debug-panel" id="debug-panel">
  <div class="debug-header">🔧 API Debug Panel</div>
  
  <div style="margin-bottom: 16px;">
    <h3>Quick Tests</h3>
    <button onclick="testDashboardData()" style="background: #64ffda; color: #0c1426; border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer; margin: 4px;">Test API Endpoints</button>
    <button onclick="window.location.reload()" style="background: #ff9800; color: #ffffff; border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer; margin: 4px;">Reload Page</button>
  </div>
</div>

<script src="app.js"></script>
</body>
</html>
