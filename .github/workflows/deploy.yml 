name: Deploy Streamlit Bot

on:
  push:
    branches:
      - main

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v3

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Deploy to Railway
        if: env.RAILWAY_TOKEN != ''
        run: |
          curl -fsSL https://railway.app/install.sh | sh
          railway up --service Bottie --token ${{ secrets.RAILWAY_TOKEN }}

      - name: Deploy to Render
        if: env.RENDER_API_KEY != ''
        run: |
          curl -sSL https://render.com/deploy | bash
          # Optionally integrate render.yaml for full automation

      - name: Deploy to Heroku
        if: env.HEROKU_API_KEY != ''
        run: |
          echo "machine api.heroku.com" > ~/.netrc
          echo "  login ${{ secrets.HEROKU_EMAIL }}" >> ~/.netrc
          echo "  password ${{ secrets.HEROKU_API_KEY }}" >> ~/.netrc
          heroku git:remote -a ${{ secrets.HEROKU_APP_NAME }}
          git push heroku main