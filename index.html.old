<!DOCTYPE html>
<html>
<head>
    <title>EMERGENCY API TEST - WORKING</title>
    <style>
        body { font-family: Arial, sans-serif; padding: 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; }
        .container { max-width: 800px; margin: 0 auto; background: rgba(255,255,255,0.1); padding: 30px; border-radius: 15px; backdrop-filter: blur(10px); }
        .status { padding: 15px; margin: 10px 0; border-radius: 8px; font-weight: bold; }
        .success { background: rgba(40, 167, 69, 0.9); }
        .error { background: rgba(220, 53, 69, 0.9); }
        .info { background: rgba(23, 162, 184, 0.9); }
        button { background: #28a745; color: white; border: none; padding: 15px 30px; border-radius: 8px; cursor: pointer; font-size: 16px; margin: 10px; }
        button:hover { background: #218838; }
        .version { background: rgba(255, 193, 7, 0.9); color: #212529; padding: 15px; border-radius: 8px; margin-bottom: 20px; text-align: center; font-weight: bold; }
    </style>
</head>
<body>
    <div class="container">
        <div class="version">
            🚀 EMERGENCY API TEST - v2024-08-19-FINAL
            <br>
            <small>Deployed: <span id="deployTime"></span></small>
        </div>
        
        <h1>🧪 API Endpoint Test</h1>
        <p>Testing direct API calls to verify endpoints work</p>
        
        <button onclick="testAPI()">🚀 Test API Endpoints</button>
        <button onclick="clearResults()">🗑️ Clear Results</button>
        
        <div id="results"></div>
    </div>

    <script>
        document.getElementById('deployTime').textContent = new Date().toISOString();
        
        console.log('🚀 EMERGENCY API TEST LOADED - v2024-08-19-FINAL');
        console.log('Current URL:', window.location.href);
        console.log('Timestamp:', new Date().toISOString());
        
        function addResult(message, type = 'info') {
            const div = document.createElement('div');
            div.className = `status ${type}`;
            div.innerHTML = `${new Date().toLocaleTimeString()}: ${message}`;
            document.getElementById('results').appendChild(div);
            console.log(message);
        }
        
        function clearResults() {
            document.getElementById('results').innerHTML = '';
        }
        
        async function testAPI() {
            clearResults();
            addResult('🚀 Starting API endpoint test...', 'info');
            
            // Test the proxy endpoints that should work now
            const tests = [
                { url: '/api/trades', name: 'Proxy Trades (/api/trades → /trades)' },
                { url: '/api/ml/status', name: 'Proxy ML (/api/ml/status → /ml/status)' },
                { url: '/api/health', name: 'Proxy Health (/api/health → /health)' },
                { url: 'https://bottie-1.onrender.com/trades', name: 'Direct Trades (bypass proxy)' },
                { url: 'https://bottie-1.onrender.com/ml/status', name: 'Direct ML (bypass proxy)' }
            ];
            
            let workingCount = 0;
            
            for (const test of tests) {
                try {
                    addResult(`🔍 Testing ${test.name}...`, 'info');
                    
                    const response = await fetch(test.url, {
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        }
                    });
                    
                    if (response.ok) {
                        const data = await response.json();
                        addResult(`✅ ${test.name} SUCCESS (${response.status})`, 'success');
                        workingCount++;
                        
                        if (test.url.includes('trades') && data.trades) {
                            addResult(`📈 Found ${data.trades.length} trades, P&L: $${(data.summary?.net_pnl || 0).toFixed(2)}`, 'success');
                        }
                        if (test.url.includes('ml') && data.accuracy) {
                            addResult(`🧠 ML Accuracy: ${(data.accuracy * 100).toFixed(1)}%, Predictions: ${data.total_predictions || 0}`, 'success');
                        }
                    } else {
                        addResult(`❌ ${test.name} FAILED (${response.status})`, 'error');
                    }
                } catch (error) {
                    addResult(`💥 ${test.name} ERROR: ${error.message}`, 'error');
                }
                
                // Small delay between tests
                await new Promise(resolve => setTimeout(resolve, 300));
            }
            
            addResult(`📊 SUMMARY: ${workingCount}/${tests.length} endpoints working`, workingCount > 0 ? 'success' : 'error');
            
            if (workingCount > 0) {
                addResult('🎉 SUCCESS! API is working. The proxy fix resolved the issues.', 'success');
                addResult('💡 You can now use the corrected dashboard with confidence.', 'info');
            } else {
                addResult('⚠️ No endpoints working. Check Render service status.', 'error');
            }
        }
        
        // Auto-run test after 2 seconds
        window.onload = function() {
            setTimeout(() => {
                addResult('🔄 Auto-starting API test...', 'info');
                testAPI();
            }, 2000);
        };
    </script>
</body>
</html>