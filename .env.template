# BOTTIE TRADING SYSTEM ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================================================
# EXCHANGE CONFIGURATION (REQUIRED FOR LIVE TRADING)
# ============================================================================
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_secret_key_here

# ============================================================================
# TRADING CONFIGURATION
# ============================================================================
ENVIRONMENT=production
TRADE_ENABLED=1
LIVE_TRADING_ENABLED=true
USE_TESTNET=false

# Trading parameters
EXECUTION_INTERVAL_S=20
TRADE_QUOTE_PER_ORDER=100
MAX_SPEND_PER_SYMBOL=1000
SELL_FRACTION=0.5
MAX_OPEN_POSITIONS=10
PRIMARY_QUOTE=USDT
TRADE_SYMBOLS=

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
DASHBOARD_PASSWORD=your_secure_password_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here
SUPERUSER_PASSWORD=your_superuser_password_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# ============================================================================
# DATA SOURCES (OPTIONAL)
# ============================================================================
FINNHUB_API_KEY=your_finnhub_key_for_news
NEWS_API_KEY=your_news_api_key

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================
PORT=8000
NETLIFY_URL=*

# ============================================================================
# EMAIL ALERTS (OPTIONAL)
# ============================================================================
EMAIL_SENDER=bottie@yourdomain.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_RECEIVER=alerts@yourdomain.com

# ============================================================================
# MODEL PATHS (OPTIONAL)
# ============================================================================
LSTM_MODEL_PATH=models/lstm_model.h5
XGB_MODEL_PATH=models/xgb_model.json