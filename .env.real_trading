# REAL TRADING CONFIGURATION
# WARNING: These are LIVE trading API keys - Handle with extreme care!

# Exchange Configuration
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here

# Trading Mode
LIVE_TRADING_ENABLED=false  # Set to 'true' for LIVE trading with real money
USE_TESTNET=true           # Use testnet for safety testing

# Portfolio Configuration
INITIAL_BALANCE=10000.0
RISK_PER_TRADE=0.02        # 2% risk per trade
MAX_POSITIONS=5

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Security
JWT_SECRET=your_jwt_secret_here
ADMIN_PASSWORD=Diego1234!

# Features
ENABLE_REAL_POSITIONS=true
ENABLE_LIVE_TRADING=false  # Set to true when ready for real trading
ENABLE_AUTO_TRADING=false  # Auto-trading disabled by default

# Logging
LOG_LEVEL=INFO
LOG_FILE=real_trading.log

# Risk Management
STOP_LOSS_PERCENT=0.05     # 5% stop loss
TAKE_PROFIT_PERCENT=0.10   # 10% take profit
MAX_DAILY_LOSS=0.10        # 10% max daily loss

# Data Sources
USE_REAL_PRICES=true
MARKET_DATA_SOURCE=binance
SENTIMENT_SOURCE=news_api
